# Banco de dados (Supabase Postgres)
# Runtime: use o pooler (porta 6543) com pgbouncer=true para evitar esgotar conexões.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Segurança da aplicação
JWT_SECRET="troque-por-um-segredo-forte"
ADMIN_EMAIL="adm@beend.tech"
ADMIN_PASSWORD="troque-por-uma-senha-forte"
ADMIN_RESET_SECRET=""
APP_URL="http://localhost:5173"

# Supabase Storage (imagens/logos). Preferir a chave de serviço no backend.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_STORAGE_BUCKET="uploads" # bucket do projeto; se vazio, tenta uploads/medias
SUPABASE_SERVICE_ROLE_KEY=""
# Fallback público (apenas se não houver service role)
SUPABASE_ANON_KEY=""
SUPABASE_KEY=""

# Opcional no frontend (se for usado diretamente)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# E-mail (relatórios diários via Gmail)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Operação
ENABLE_DAILY_REPORTS="true"
NODE_ENV="development"

# Rate limit de login (opcional; os padrões abaixo já são aplicados)
# Falhas por conta (IP + e-mail) antes do bloqueio de 15 min.
AUTH_RATE_LIMIT_MAX="20"
# Falhas por IP em 15 min, proteção contra varredura de várias contas.
AUTH_IP_RATE_LIMIT_MAX="200"
# Nº de proxies reversos confiáveis à frente da aplicação (Cloudflare, LB...).
# Se a infraestrutura tiver 2 hops (ex.: CDN + proxy), use 2.
TRUST_PROXY="1"
